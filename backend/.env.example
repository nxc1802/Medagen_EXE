# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# LLM
LLM_PROVIDER=google
GOOGLE_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# PayOS — lấy từ https://my.payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Optional
GOOGLE_MAPS_API_KEY=
CV_ENDPOINT=http://localhost:8000
